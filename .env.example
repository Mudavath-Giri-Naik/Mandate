# =============================================================================
# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel, add every one of these under Project → Settings → Environment
# Variables (Production + Preview + Development).
# =============================================================================

# ----------------------------------------------------------------- Supabase --
# Dashboard → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# SERVER ONLY. Bypasses Row Level Security. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# ----------------------------------------------------------------- Razorpay --
# Dashboard → Settings → API Keys, with the Test Mode toggle ON.
# The key id MUST start with rzp_test_ for this project.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# SERVER ONLY. Signs and verifies payments. Leaking this lets anyone forge a
# "paid" signature.
RAZORPAY_KEY_SECRET=your_test_key_secret

# Same value as RAZORPAY_KEY_ID. Safe in the browser — Checkout.js needs it.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Optional. Only needed if you wire up /api/orders/webhook in the Razorpay
# dashboard (Settings → Webhooks). Everything works without it.
# RAZORPAY_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------- Behaviour
# Minutes an order may sit in `reserved` before the sweeper releases its stock.
RESERVATION_TTL_MINUTES=10

# Optional. When set, POST/GET /api/orders/cancel-expired requires
# `Authorization: Bearer <this>`. Vercel Cron sends it automatically.
# Leave unset locally so you can call the endpoint from Postman.
# CRON_SECRET=some-long-random-string
