              ],
              "query": [
                {
                  "key": "size",
                  "value": "M"
                },
                {
                  "key": "color",
                  "value": "Indigo"
                },
                {
                  "key": "max_price",
                  "value": "200000"
                }
              ]
            }
          }
        },
